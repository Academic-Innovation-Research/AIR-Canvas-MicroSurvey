# macOS
.DS_Store

# Credentials — never commit
# Bare pattern, not just Metabase/.env: a stray .env at the repo root would
# otherwise be picked up by `git add -A`.
.env
Metabase/.env

# Metabase application database (large binary, regenerated on first run)
Metabase/metabase.db.mv.db
Metabase/metabase.db.trace.db
# Rollback copies: pre-import-*, pre-postgres-*, and any future suffix.
# Broad by design — these are multi-MB binaries and none belong in git.
Metabase/metabase.db.mv.db.*

# Data pipeline — local working files with real institutional data
data-handling-scripts/Notes.md
data-handling-scripts/notes.txt
data-handling-scripts/courses.csv
data-handling-scripts/courses_enriched.csv
data-handling-scripts/survey.csv
data-handling-scripts/sql/
data-handling-scripts/Enrollment/
data-handling-scripts/Enrollment/*

# Python cache
data-handling-scripts/__pycache__/
**/*.pyc

